<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= type %> Items - University Lost & Found</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <main>
        <section class="page-header">
            <div class="container">
                <h1><%= type %> Items</h1>
                <p>Browse all <%= type.toLowerCase() %> items reported by students</p>
            </div>
        </section>

        <section class="items-section">
            <div class="container">
                <% if (items.length === 0) { %>
                    <div class="no-items-message">
                        <h2>No <%= type.toLowerCase() %> items found</h2>
                        <p>Be the first to report a <%= type.toLowerCase() %> item!</p>
                        <a href="/report/<%= type.toLowerCase() %>" class="btn btn-primary">Report <%= type %> Item</a>
                    </div>
                <% } else { %>
                    <div class="items-count">
                        <p>Showing <%= items.length %> <%= type.toLowerCase() %> item<%= items.length !== 1 ? 's' : '' %></p>
                    </div>
                    <div class="items-grid">
                        <% items.forEach(item => { %>
                            <div class="item-card">
                                <div class="item-image" style="background-image: url('<%= item.imageUrl %>')"></div>
                                <div class="item-content">
                                    <span class="item-badge <%= item.status %>"><%= item.status.charAt(0).toUpperCase() + item.status.slice(1) %></span>
                                    <h3><%= item.title %></h3>
                                    <p class="item-category"><%= item.category %></p>
                                    <p class="item-description"><%= item.description.substring(0, 100) %><%= item.description.length > 100 ? '...' : '' %></p>
                                    <p class="item-location">📍 <%= item.location %></p>
                                    <p class="item-date">📅 <%= new Date(item.date).toLocaleDateString() %></p>
                                    <a href="/item/<%= item._id %>" class="btn btn-small">View Details</a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
