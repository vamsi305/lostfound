<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Items - University Lost & Found</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <main>
        <section class="page-header">
            <div class="container">
                <h1>My Items</h1>
                <p>Items you've reported as lost or found</p>
            </div>
        </section>

        <section class="items-section">
            <div class="container">
                <% if (items.length === 0) { %>
                    <div class="no-items-message">
                        <h2>You haven't reported any items yet</h2>
                        <p>Start by reporting a lost or found item</p>
                        <div class="hero-buttons">
                            <a href="/report/lost" class="btn btn-primary">Report Lost Item</a>
                            <a href="/report/found" class="btn btn-secondary">Report Found Item</a>
                        </div>
                    </div>
                <% } else { %>
                    <div class="items-count">
                        <p>You have <%= items.length %> item<%= items.length !== 1 ? 's' : '' %></p>
                    </div>
                    <div class="items-grid">
                        <% items.forEach(item => { %>
                            <div class="item-card <%= item.resolved ? 'resolved-item' : '' %>">
                                <div class="item-image" style="background-image: url('<%= item.imageUrl %>')"></div>
                                <div class="item-content">
                                    <span class="item-badge <%= item.status %>"><%= item.status.charAt(0).toUpperCase() + item.status.slice(1) %></span>
                                    <% if (item.resolved) { %>
                                        <span class="item-badge resolved">Resolved</span>
                                    <% } %>
                                    <h3><%= item.title %></h3>
                                    <p class="item-category"><%= item.category %></p>
                                    <p class="item-description"><%= item.description.substring(0, 100) %><%= item.description.length > 100 ? '...' : '' %></p>
                                    <p class="item-location">📍 <%= item.location %></p>
                                    <p class="item-date">📅 <%= new Date(item.date).toLocaleDateString() %></p>
                                    <div class="item-actions">
                                        <a href="/item/<%= item._id %>" class="btn btn-small">View Details</a>
                                        <% if (!item.resolved) { %>
                                            <button onclick="deleteItem('<%= item._id %>')" class="btn btn-small btn-danger">Delete</button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        function deleteItem(itemId) {
            if (confirm('Are you sure you want to delete this item?')) {
                fetch(`/item/${itemId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to delete item');
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Error deleting item');
                });
            }
        }
    </script>
</body>
</html>
